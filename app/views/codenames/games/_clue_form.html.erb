<%# locals: (game:, clue_form:) %>

<%= form_with model: clue_form, scope: :clue,
    url: submit_clue_codenames_game_path(game.id), method: :patch do |form| %>
  <div class="card border-0 shadow-sm mb-2">
    <div class="card-body p-2 p-sm-3">
      <div class="row g-2 align-items-end">
        <div class="col-12 col-sm">
          <%= form.label :word, "Your clue", class: "small fw-semibold mb-1" %>
          <%= form.text_field :word, placeholder: "e.g. Ocean",
              autocomplete: "off", autofocus: true, required: true,
              enterkeyhint: "send",
              maxlength: Codenames::Game::CLUE_LENGTH.max %>
        </div>
        <div class="col-4 col-sm-auto">
          <%= form.label :number, "Number", class: "small fw-semibold mb-1" %>
          <%= form.select :number,
              Codenames::ClueForm::NUMBERS.map { |number|
                [number == "unlimited" ? "∞" : number, number]
              },
              selected: clue_form.selected_number %>
        </div>
        <div class="col-8 col-sm-auto">
          <%= form.button "Send clue", class: "btn btn-success w-100",
              data: { turbo_submits_with: "Sending…" } do %>
            <i class="bi bi-send-fill me-1"></i>
            Send clue
          <% end %>
        </div>
      </div>
      <div class="form-text">
        The number is how many of your cards relate — 0 for none,
        ∞ for unlimited.
      </div>
    </div>
  </div>
<% end %>
