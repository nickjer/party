<%# locals: (new_player:) %>

<div class="row justify-content-center py-4">
  <div class="col-md-8 col-lg-6">
    <%= link_to root_path, class: "btn btn-link ps-0 mb-3" do %>
      <i class="bi bi-arrow-left me-1"></i>
      Back to Games
    <% end %>

    <div class="card shadow">
      <div class="card-body p-4">
        <div class="text-center mb-4">
          <h1 class="h2 text-info mb-2">
            <i class="bi bi-speedometer2 me-2"></i>
            Wavelength
          </h1>
          <p class="text-muted mb-0">Join the game and pick a team!</p>
        </div>

        <%= form_with(model: new_player, scope: :player, url: wavelength_game_player_path(new_player.game.id)) do |form| %>
          <div class="mb-4">
            <%= render "players/name_field", form: %>
          </div>

          <%= form.submit "Join Game", class: "btn-lg w-100 btn-info" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
