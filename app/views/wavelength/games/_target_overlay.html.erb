<%# locals: (target:) %>
<% target.bands.each do |band| %>
  <% next if band.width <= 0 %>
  <% opacity = { 4 => 1, 3 => 0.65, 2 => 0.4 }.fetch(band.points) %>
  <% band_style = "left: #{band.from}%; width: #{band.width}%; " \
       "background-color: rgba(25, 135, 84, #{opacity}); " \
       "text-shadow: 0 1px 2px rgba(0, 0, 0, .45);" %>
  <div class="position-absolute top-0 bottom-0 d-flex align-items-center justify-content-center text-white fw-bold"
       style="<%= band_style %>">
    <%= band.points %>
  </div>
<% end %>
<% center_style = "left: #{target.position}%;" %>
<div class="position-absolute top-0 bottom-0 border-start border-2 border-white"
     style="<%= center_style %>"></div>
