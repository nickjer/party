<%# locals: (game:, reveal:, interactive:, concealable: false) %>
<% spectrum = game.spectrum %>
<% controller = interactive ? "dial" : "" %>
<% marker_id = "wl_dial_marker_#{game.id}" %>

<div class="card shadow-sm" data-controller="<%= controller %>"
     data-dial-url-value="<%= move_dial_wavelength_game_path(game.id) %>">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center mb-2">
      <span class="badge rounded-pill bg-info-subtle text-info-emphasis fs-6">
        <i class="bi bi-caret-left-fill me-1"></i><%= spectrum.left %>
      </span>
      <span class="badge rounded-pill bg-info-subtle text-info-emphasis fs-6">
        <%= spectrum.right %><i class="bi bi-caret-right-fill ms-1"></i>
      </span>
    </div>

    <% if interactive %>
      <%# The range input overlays the track with an invisible thumb; the dark
          marker is a separate element moved locally and by live broadcasts. %>
      <%= form_with url: lock_guess_wavelength_game_path(game.id), method: :patch do |form| %>
        <div class="position-relative bg-body-secondary border rounded my-4"
             style="height: 3rem;">
          <div id="<%= marker_id %>" class="position-absolute top-0 bottom-0 start-0 end-0"
               style="pointer-events: none;">
            <%= render "wavelength/games/dial_marker", game:, reveal: false %>
          </div>
          <%= form.range_field "guess[position]", value: game.guess,
              in: 0..100, step: 1,
              class: "wl-dial-range position-absolute top-0 start-0 w-100",
              style: "height: 3rem; margin: 0;",
              data: { dial_target: "input",
                action: "input->dial#move change->dial#commit" } %>
        </div>
        <%= form.submit "Lock it in", class: "btn btn-info w-100 mt-2" %>
      <% end %>
    <% else %>
      <div class="position-relative bg-body-secondary border rounded my-4"
           style="height: 3rem;">
        <% if reveal %>
          <%# Target bands are a reveal item so the psychic's toggle hides them;
              the attribute is harmless when no reveal controller is present. %>
          <div data-reveal-target="item">
            <%= render "wavelength/games/target_overlay", target: game.target %>
          </div>
        <% end %>
        <div id="<%= marker_id %>" class="position-absolute top-0 bottom-0 start-0 end-0">
          <%= render "wavelength/games/dial_marker", game:, reveal: %>
        </div>
      </div>

      <% if concealable %>
        <button type="button" class="btn btn-outline-secondary w-100 mt-2"
          data-action="reveal#toggle">
          <i class="bi bi-eye-fill me-1"></i>
          Show / hide target
        </button>
      <% end %>
    <% end %>
  </div>
</div>
