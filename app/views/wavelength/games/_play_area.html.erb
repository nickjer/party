<%# locals: (game:, current_player:, clue_form: nil) %>

<%= render "wavelength/games/status_bar", game:, current_player: %>

<% on_active_team = current_player.team == game.current_team %>
<% is_psychic = game.psychic?(current_player) %>

<% if game.status.completed? %>
  <%= render "wavelength/games/dial", game:, reveal: true, interactive: false %>

<% elsif game.status.reveal? %>
  <%= render "wavelength/games/dial", game:, reveal: true, interactive: false %>
  <% up_team = game.current_team.opponent %>
  <% suggested = game.suggested_psychic %>
  <% on_up_team = current_player.team == up_team %>
  <p class="text-center text-muted mt-3 mb-2">
    <% if !on_up_team %>
      Waiting for the <%= up_team.to_s.capitalize %> team to pick a psychic…
      <% if suggested %><strong><%= suggested.name %></strong> is up.<% end %>
    <% elsif suggested && suggested.id != current_player.id %>
      <strong><%= suggested.name %></strong> is up next — but anyone on
      <%= up_team.to_s.capitalize %> can continue and be the psychic.
    <% else %>
      You're up — continue to be the psychic.
    <% end %>
  </p>
  <% if on_up_team %>
    <%= button_to next_round_wavelength_game_path(game.id), method: :post,
        form_class: "d-grid", class: "btn btn-lg btn-info" do %>
      <i class="bi bi-arrow-right-circle-fill me-1"></i>
      Next round
    <% end %>
  <% end %>

<% elsif game.status.left_right? %>
  <% if is_psychic %>
    <%= render "wavelength/games/psychic_dial", game: %>
  <% else %>
    <%= render "wavelength/games/dial", game:, reveal: false, interactive: false %>
  <% end %>
  <% if on_active_team %>
    <p class="text-center text-muted mt-3">
      Waiting for the <%= game.current_team.opponent %> team to guess left or right…
    </p>
  <% else %>
    <p class="text-center fw-bold mt-3">Is the target left or right of the dial?</p>
    <div class="d-flex gap-2">
      <% %w[left right].each do |side| %>
        <%= button_to guess_side_wavelength_game_path(game.id), method: :patch,
            params: { guess: { side: } },
            form_class: "d-grid flex-grow-1 m-0",
            class: "btn btn-lg btn-outline-dark" do %>
          <%= side == "left" ? "← Left" : "Right →" %>
        <% end %>
      <% end %>
    </div>
  <% end %>

<% elsif game.status.clue? %>
  <% if is_psychic %>
    <%= render "wavelength/games/psychic_dial", game: %>
    <%= render "wavelength/games/clue_form", game:,
        clue_form: clue_form || Wavelength::ClueForm.new %>
  <% else %>
    <%= render "wavelength/games/dial", game:, reveal: false, interactive: false %>
    <p class="text-center text-muted mt-3">
      Waiting for <%= game.psychic.name %> to give a clue…
    </p>
  <% end %>

<% else %>
  <% if is_psychic %>
    <%= render "wavelength/games/psychic_dial", game: %>
  <% elsif on_active_team %>
    <%= render "wavelength/games/dial", game:, reveal: false, interactive: true %>
  <% else %>
    <%= render "wavelength/games/dial", game:, reveal: false, interactive: false %>
    <p class="text-center text-muted mt-3">
      <%= game.current_team.to_s.capitalize %> team is guessing…
    </p>
  <% end %>
<% end %>
